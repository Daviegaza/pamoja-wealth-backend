# App
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
# Web app URL (used for subscription checkout return links)
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,capacitor://localhost
# Reverse proxies in front of the API (Fly.io = 1). Controls req.ip.
TRUST_PROXY_HOPS=0

# Database
DATABASE_URL=postgresql://pamoja:pamoja@localhost:5432/pamoja
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# Redis (refresh tokens, OTPs, login lockout, rate limits) — required in production
REDIS_URL=redis://localhost:6379

# Secrets — REQUIRED in production (the API refuses to start without them).
# JWT secrets: >= 32 chars. ENCRYPTION_KEY: 64 hex chars (openssl rand -hex 32).
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
ENCRYPTION_KEY=

# SaaS subscription billing ONLY (a chama paying Pamoja's subscription fee).
# Never used for member contributions — Pamoja does not hold member money.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=

# Email (SendGrid)
SENDGRID_API_KEY=
EMAIL_FROM=noreply@pamojawealth.com

# SMS (Africa's Talking)
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=Pamoja

# Monitoring
SENTRY_DSN=
# /metrics needs "Authorization: Bearer $METRICS_TOKEN" in production (disabled if unset)
METRICS_TOKEN=
LOG_LEVEL=
